{
  "name": "cpazen",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx scripts/seed-database.ts",
    "deploy:edge": "bash scripts/deploy-edge-functions.sh",
    "deploy:web": "cd apps/web && npm run build",
    "deploy:all": "npm run deploy:edge && npm run build && npm run deploy:web",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.12.0",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
